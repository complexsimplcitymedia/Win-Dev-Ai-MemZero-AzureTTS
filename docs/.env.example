# Example .env file for Win-Dev-Ai-MemZero-AzureTTS
# Copy this file to .env and fill in your values

# Azure Text-to-Speech Configuration
# Get your key from Azure Portal: https://portal.azure.com
AZURE_TTS_KEY=your-azure-tts-subscription-key-here
AZURE_TTS_REGION=eastus

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m

# Memory Configuration
MEMORY_STORAGE_PATH=memory/universal_memory.json
MEMORY_MAX_SIZE=10000

# MCP Configuration
MCP_CONFIG_PATH=mcp_config.json

# Logging Configuration
LOG_LEVEL=INFO
