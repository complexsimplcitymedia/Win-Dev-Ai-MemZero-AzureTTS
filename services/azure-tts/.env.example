# Azure Speech Service Credentials
# Get your free key at: https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Voice Settings (optional)
# Male voices: en-US-GuyNeural, en-US-DavisNeural, en-US-JasonNeural, en-US-TonyNeural
# Female voices: en-US-JennyNeural, en-US-AriaNeural, en-US-JaneNeural, en-US-SaraNeural
VOICE_NAME=en-US-GuyNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz